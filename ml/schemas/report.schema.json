{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fasl/report.schema.json",
  "title": "Fasl /predict response",
  "description": "Mirrors the Report type in lib/demo/types.ts, or the unclear-photo response.",
  "oneOf": [
    {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "const": "unclear" },
        "message": { "type": "string" }
      }
    },
    {
      "type": "object",
      "required": ["crop", "stage", "readiness", "health", "actions"],
      "properties": {
        "crop": {
          "type": "object",
          "required": ["name", "confidence"],
          "properties": {
            "name": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "stage": {
          "type": "object",
          "required": ["index", "name", "total", "confidence"],
          "properties": {
            "index": { "type": "integer", "minimum": 1 },
            "name": { "type": "string" },
            "total": { "type": "integer", "minimum": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "readiness": {
          "type": "object",
          "required": ["ready"],
          "properties": {
            "ready": { "type": "boolean" },
            "daysLeft": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
          }
        },
        "health": {
          "type": "object",
          "required": ["status", "confidence"],
          "properties": {
            "status": { "enum": ["healthy", "disease"] },
            "disease": { "type": "string" },
            "severity": { "enum": ["mild", "moderate", "severe"] },
            "location": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "actions": { "type": "array", "items": { "type": "string" } },
        "heatmapUrl": { "type": "string" },
        "urduAudioUrl": { "type": "string" }
      }
    }
  ]
}
